generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Roles: "CLIENT" | "ADMIN"
model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          String         @default("CLIENT")
  provider      String         @default("credentials")
  createdAt     DateTime       @default(now())
  orders        Order[]
  wishlist      WishlistItem[]
}

// Tokens de verificación de correo (se guarda solo el hash SHA-256)
model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

// Categorías: "SINGLE" | "SEALED" | "GRADED"
model Product {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  category    String
  setName     String
  number      String?
  rarity      String?
  description String
  priceUsd    Float
  costUsd     Float          @default(0)
  stock       Int            @default(0)
  enabled     Boolean        @default(true)
  available   Boolean        @default(true)
  theme       String         @default("latios") // latios | latias | rayquaza | duo
  isSecret    Boolean        @default(false)    // borde dorado (alt-art / secreta)
  grade       String?
  referenceNote String?
  imageUrl    String?
  views       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orderItems  OrderItem[]
  wishlistBy  WishlistItem[]
}

// Estados: "PAID" | "PREPARING" | "SHIPPED" | "DELIVERED" | "CANCELLED"
model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  status         String      @default("PAID")
  totalClp       Int
  costClp        Int
  shippingName   String
  shippingAddress String
  shippingCity   String
  phone          String
  trackingCode   String?
  createdAt      DateTime    @default(now())
  items          OrderItem[]
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  quantity     Int
  unitPriceClp Int
  unitCostClp  Int
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// Solicitudes del módulo "Compramos tus cartas"
model SellRequest {
  id             String   @id @default(cuid())
  fullName       String
  email          String
  phone          String
  description    String
  estimatedValue Float
  currency       String
  files          String   // JSON con nombres de archivo guardados
  status         String   @default("NEW") // NEW | CONTACTED | CLOSED
  createdAt      DateTime @default(now())
}

// Visitas diarias para métricas de conversión
model DailyVisit {
  day   String @id // YYYY-MM-DD
  count Int    @default(0)
}
